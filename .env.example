# Ethereum Sepolia testnet ONLY. Fund wallets from public faucets — never real ETH.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# testnet-only throwaway keys
DEPLOYER_PRIVATE_KEY=      # also the resolver
SELLER_PRIVATE_KEY=
BUYER_PRIVATE_KEY=

# filled in after `forge script script/Deploy.s.sol ... --broadcast`
PROBE_MARKET_ADDRESS=

# marketplace economics (ETH)
LISTING_PRICE=0.0005
LISTING_STAKE=0.001
BUYER_PRICE_CEILING=0.001

# seller behaviour
TARGET_MODEL=sentinel-v1
SUITE_TRIALS=8
SELLER_MODES=honest,overfit,garbage   # per-round; honest reproduces, overfit gets slashed, garbage gets disputed
SELLER_ROUNDS=3

# buyer trust rule
BUYER_MIN_RESOLVED=3          # reputation gate engages after this many sold+resolved findings
BUYER_MIN_REPRO_RATE=0.6      # required reproduction rate once proven

# demo pacing (seconds)
RESOLUTION_DELAY=420
REVEAL_WINDOW=600
DISPUTE_WINDOW=180

# optional: pin suites publicly via Pinata free tier
PINATA_JWT=
